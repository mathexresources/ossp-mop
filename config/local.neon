parameters:
    appUrl: %appUrl%
    mailFrom: %mailFrom%

# Nette MailExtension config — creates mail.mailer as SmtpMailer automatically.
mail:
    smtp: true
    host: %smtpHost%
    port: %smtpPort%
    username: %smtpUser%
    password: %smtpPassword%
    secure: %smtpSecure%

database:
    dsn: 'mysql:host=%dbHost%;dbname=%dbName%;charset=utf8mb4'
    user: %dbUser%
    password: %dbPassword%
    options:
        lazy: true
