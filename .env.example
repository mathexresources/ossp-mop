# ── Application ──────────────────────────────────────────────────────────────
NETTE_DEBUG=0
APP_URL=https://yourdomain.com
MAIL_FROM=SnapFix <noreply@yourdomain.com>

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=database
DB_NAME=snapfix
DB_USER=snapfix
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

# ── SMTP (Resend) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_api_key_here
SMTP_SECURE=ssl

